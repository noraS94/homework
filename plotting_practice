library(viridis)

cols <- viridis(20, option = "magma")

data("iris")

#viridis + base R plots
boxplot(data = iris, Sepal.Length ~ Species, 
        ylab = "Petal Length", xlab = "Species", col = cols[c(5,12,19)])

library(ggplot2)

#which bin width? Freedman-Diaconis rule
binwidth <- 2 * IQR(iris$Petal.Length) / length(iris$Petal.Length)^(1/3)
#Or use bin count using Sturges
#bincount <- nclass.Sturges(iris$Petal.Length)

ggplot(iris, aes(x = Petal.Length, fill = Species)) +
  geom_histogram(position = "dodge", binwidth = binwidth) + 
  scale_fill_viridis(discrete = TRUE) + labs(title = "Plotting Practice", x = "Petal Length") +
  theme(plot.title = element_text(hjust = 0.5)) #centering the title

#Point
ggplot(iris, aes(x = Petal.Length, y = Sepal.Length, color = Species)) +
  geom_point(size = 4) +
  scale_color_manual(values = cols[c(5,12,16)]) +
  theme_bw()
